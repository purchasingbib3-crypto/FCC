[Unit]
Description=FCC PPA-BIB Static + API Proxy
After=network.target fcc-api.service

[Service]
Type=simple
User=fcc
Group=fcc
WorkingDirectory=/opt/fcc/current
EnvironmentFile=/etc/fcc/fcc.env
ExecStart=/opt/fcc/current/.venv/bin/python /opt/fcc/current/04_api-legacy/static_proxy.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
