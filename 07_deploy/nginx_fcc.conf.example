# FCC V12 same-origin reverse proxy example.
# Replace the hostname and TLS certificate directives with your environment.
server {
    listen 443 ssl http2;
    server_name YOUR_FCC_HOST.example;

    # TLS directives are deployment-specific.
    # ssl_certificate ...;
    # ssl_certificate_key ...;

    # Actual supplied source files are ~5-7 MB. Keep comfortable headroom.
    client_max_body_size 60m;
    client_body_timeout 300s;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_request_buffering off;

        # Keep UI and /api/ on one public origin.
        proxy_pass http://127.0.0.1:8765;
    }
}
